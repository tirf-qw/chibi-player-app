{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChibiPlayer",
  "version": "1.0.0",
  "identifier": "app.chibi.player",
  "build": { "frontendDist": "../dist" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Chibi Player",
        "width": 800,
        "height": 600,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": false }
}
